{
  "name": "promptiff",
  "version": "0.3.0",
  "private": true,
  "description": "Local prompt and AI output comparison canvas, CLI and Agent skill",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BrantonLiu/promptiff.git"
  },
  "files": [
    "cli/",
    "public/canvas/",
    "skills/",
    "examples/",
    "docs/agent-canvas.md",
    "docs/development.md",
    "docs/methodology.md",
    "scripts/build-canvas-demo.mjs",
    "docs/rename-promptiff.md"
  ],
  "scripts": {
    "canvas": "node cli/promptiff.mjs",
    "dev": "node cli/promptiff.mjs serve --session examples/session.json",
    "test": "node --test tests/*.test.mjs",
    "lint": "oxlint cli public/canvas scripts tests",
    "format": "oxfmt"
  },
  "devDependencies": {
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0"
  }
}
